# LIA Assistant - Environment Variables Configuration

# Gemini API Key for logical router and cognitive capabilities
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model selection (e.g. gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Local Obsidian Vault absolute path for persistent long term memory
OBSIDIAN_VAULT_PATH=C:\Users\YourUsername\Documents\ObsidianVault

# Whisper local model configuration (e.g. 'tiny', 'base', 'small', 'medium')
WHISPER_MODEL_PATH=base

# Debug mode (True/False)
DEBUG=True
